# Copy to backend/.env and fill in. Never commit .env.
# Google AI Studio key. Leave empty to run fully offline (deterministic template explanations).
GEMINI_API_KEY=
# SQLite by default; Postgres works too: postgresql://user:pass@host:5432/reconai
DATABASE_URL=sqlite:///./reconai.db
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# demo = role from X-Demo-Role header; jwt = HS256 bearer token (set JWT_SECRET)
AUTH_MODE=demo
# JWT_SECRET=
# Used to build report share links
PUBLIC_BASE_URL=http://localhost:8000
