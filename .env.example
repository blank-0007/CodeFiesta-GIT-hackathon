# ReconAI frontend environment (copy to .env.local for `npm run dev`).

# Origin of the ReconAI FastAPI backend. Requests go to ${VITE_API_BASE_URL}/api/...
# Leave empty to use same-origin /api (e.g. behind a reverse proxy).
VITE_API_BASE_URL=http://localhost:8000

# Mock API switch. Default `false` = talk to the real backend above.
# Set to `true` to run entirely in the browser against the MSW mock API (no backend needed).
VITE_USE_MOCKS=false
